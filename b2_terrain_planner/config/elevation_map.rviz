Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Global Options:
    Fixed Frame: elevation_odom
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Plane Cell Count: 20
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Marker Scale: 0.5
    - Class: rviz_default_plugins/PointCloud2
      Name: LiDAR
      Enabled: true
      Topic:
        Value: /elevation/points
        Depth: 5
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Size (m): 0.02
      Style: Points
      Color Transformer: AxisColor
      Axis: Z
    - Class: grid_map_rviz_plugin/GridMap
      Name: ElevationMap
      Enabled: true
      Topic:
        Value: /elevation_mapping_node/elevation_map_raw
        Depth: 5
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Show Grid Lines: false
      Height Layer: elevation
      Height Transformer: GridMapLayer
      Color Layer: elevation
      Color Transformer: IntensityLayer
      Use Rainbow: true
    - Class: rviz_default_plugins/MarkerArray
      Name: TerrainPlan
      Enabled: true
      Topic:
        Value: /terrain_planner/markers
        Depth: 5
        Reliability Policy: Reliable
        Durability Policy: Volatile
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Target Frame: elevation_base
      Distance: 6.0
      Pitch: 0.6
      Focal Point:
        X: 0.0
        Y: 0.0
        Z: 0.0
Window Geometry:
  Width: 1280
  Height: 800
